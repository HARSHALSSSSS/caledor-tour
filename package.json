{
  "name": "caledor-tour",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "node dev-server.cjs",
    "start:backend": "cd backend && npm start",
    "start:frontend": "node dev-server.cjs",
    "install:all": "npm install && cd backend && npm install",
    "seed": "cd backend && npm run seed",
    "bootstrap": "cd backend && npm run bootstrap",
    "import-media": "cd backend && npm run import-media"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "express": "^4.21.1",
    "http-proxy-middleware": "^3.0.3"
  }
}

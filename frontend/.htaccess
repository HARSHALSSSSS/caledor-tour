# cPanel static hosting rules for Caledor DMC
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# PHP on CGI often drops Authorization; pass it through for media-upload.php
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Legacy /uploads files still live on Render. New admin uploads go to /media on cPanel.
RewriteRule ^uploads/(.*)$ https://caledor-tour.onrender.com/uploads/$1 [R=302,L,NC]

# Pretty URLs (same behavior as local dev-server / Vercel rewrites)
RewriteRule ^package/([^/]+)/?$ /package-detail.html?slug=$1 [L,QSA,NC]
RewriteRule ^premium-services/?$ /premium-services.html [L,NC]
</IfModule>

# Stop browsers keeping old JS/CSS that still shows demo packages
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-APP.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-RENDER-APP.onrender.com/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://YOUR-RENDER-APP.onrender.com/socket.io/:path*"
    },
    {
      "source": "/package/:slug",
      "destination": "/package-detail.html?slug=:slug"
    }
  ]
}

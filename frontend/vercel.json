{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://caledor-tour.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://caledor-tour.onrender.com/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://caledor-tour.onrender.com/socket.io/:path*"
    },
    {
      "source": "/package/:slug",
      "destination": "/package-detail.html?slug=:slug"
    },
    {
      "source": "/premium-services",
      "destination": "/premium-services.html"
    }
  ],
  "headers": [
    {
      "source": "/package-detail.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/package-detail.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
